		function X:updateAutoClicker(now)
			if not self.AutoClicker or not HEXA_IS_VIP then return end
			local cps = math.clamp(self.AutoClickCps, 1, 60)
			if now - self.LastAutoClick < (1 / cps) then return end
			local mousePosition = UserInputService:GetMouseLocation()
			if self:isPointerOverInterface(mousePosition) then return end
			self.LastAutoClick = now
			self:performAutoClick()
		end

		function X:cachePerformanceProperty(object, propertyName)
			if object == nil then return false end
			local objectCache = self.PerformanceCache[object]
			if not objectCache then
				objectCache = {}
				self.PerformanceCache[object] = objectCache
			end
			if objectCache[propertyName] ~= nil then return true end
			local ok, value = pcall(function() return object[propertyName] end)
			if not ok then return false end
			objectCache[propertyName] = {value = value}
			return true
		end

		function X:setPerformanceProperty(object, propertyName, value)
			if not self:cachePerformanceProperty(object, propertyName) then return end
			pcall(function() object[propertyName] = value end)
		end

		function X:optimizePerformanceObject(object)
			if object == nil then return end
			if typeof(object) == "Instance" and object:IsDescendantOf(ScreenGui) then return end

			if object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam")
				or object:IsA("Smoke") or object:IsA("Fire") or object:IsA("Sparkles") then
				self:setPerformanceProperty(object, "Enabled", false)
			elseif object:IsA("PointLight") or object:IsA("SpotLight") or object:IsA("SurfaceLight") then
				self:setPerformanceProperty(object, "Enabled", false)
			elseif object:IsA("Decal") or object:IsA("Texture") then
				self:setPerformanceProperty(object, "Transparency", 1)
			elseif object:IsA("PostEffect") then
				self:setPerformanceProperty(object, "Enabled", false)
			elseif object:IsA("Atmosphere") then
				self:setPerformanceProperty(object, "Density", 0)
				self:setPerformanceProperty(object, "Haze", 0)
				self:setPerformanceProperty(object, "Glare", 0)
			elseif object:IsA("Clouds") then
				self:setPerformanceProperty(object, "Cover", 0)
				self:setPerformanceProperty(object, "Density", 0)
			elseif object:IsA("Sky") or object:IsA("SurfaceAppearance") then
				self:setPerformanceProperty(object, "Parent", nil)
			elseif object:IsA("SpecialMesh") then
				self:setPerformanceProperty(object, "TextureId", "")
			elseif object:IsA("MeshPart") then
				self:setPerformanceProperty(object, "TextureID", "")
				self:setPerformanceProperty(object, "RenderFidelity", Enum.RenderFidelity.Performance)
				self:setPerformanceProperty(object, "CastShadow", false)
				self:setPerformanceProperty(object, "Reflectance", 0)
				self:setPerformanceProperty(object, "Material", Enum.Material.SmoothPlastic)
				self:setPerformanceProperty(object, "MaterialVariant", "")
			elseif object:IsA("BasePart") then
				self:setPerformanceProperty(object, "CastShadow", false)
				self:setPerformanceProperty(object, "Reflectance", 0)
				self:setPerformanceProperty(object, "Material", Enum.Material.SmoothPlastic)
				self:setPerformanceProperty(object, "MaterialVariant", "")
			elseif object:IsA("Model") then
				pcall(function()
					self:setPerformanceProperty(object, "LevelOfDetail", Enum.ModelLevelOfDetail.StreamingMesh)
				end)
			end
		end

		function X:applyPerformanceGlobals()
			self:setPerformanceProperty(Lighting, "GlobalShadows", false)
			self:setPerformanceProperty(Lighting, "Brightness", 1)
			self:setPerformanceProperty(Lighting, "EnvironmentDiffuseScale", 0)
			self:setPerformanceProperty(Lighting, "EnvironmentSpecularScale", 0)
			self:setPerformanceProperty(Lighting, "FogStart", 1000000)
			self:setPerformanceProperty(Lighting, "FogEnd", 1000000)

			local terrain = workspace:FindFirstChildOfClass("Terrain")
			if terrain then
				self:setPerformanceProperty(terrain, "WaterWaveSize", 0)
				self:setPerformanceProperty(terrain, "WaterWaveSpeed", 0)
				self:setPerformanceProperty(terrain, "WaterReflectance", 0)
				self:setPerformanceProperty(terrain, "WaterTransparency", 1)
				self:setPerformanceProperty(terrain, "Decoration", false)
			end

			pcall(function()
				local rendering = settings().Rendering
				self:setPerformanceProperty(rendering, "QualityLevel", Enum.QualityLevel.Level01)
				pcall(function()
					self:setPerformanceProperty(rendering, "MeshPartDetailLevel", Enum.MeshPartDetailLevel.Level01)
				end)
			end)
		end

		function X:restorePerformance()
			for object, properties in pairs(self.PerformanceCache) do
				local parentData = properties.Parent
				if parentData then pcall(function() object.Parent = parentData.value end) end
				for propertyName, data in pairs(properties) do
					if propertyName ~= "Parent" then
						pcall(function() object[propertyName] = data.value end)
					end
				end
			end
			table.clear(self.PerformanceCache)
		end

		function X:applyPerformance()
			local generation = self.PerformanceGeneration
			if not self.Performance then
				self:restorePerformance()
				return
			end

			self:applyPerformanceGlobals()
			task.spawn(function()
				local descendants = game:GetDescendants()
				for index, object in ipairs(descendants) do
					if not self.Performance or generation ~= self.PerformanceGeneration then return end
					self:optimizePerformanceObject(object)
					if index % 250 == 0 then RunService.Heartbeat:Wait() end
				end
			end)
		end

